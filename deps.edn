{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). Both
 ;; live in the kotoba-lang org of this workspace. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates. langchain is pinned here
 ;; directly (not only under :dev) so a bare `clojure -M:test` works
 ;; offline inside the monorepo checkout without depending on
 ;; langgraph's own transitive git/sha pin being fetchable.
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}
        ;; jp-go-digital-design-system (DADS) -- the workspace's base design
        ;; system, used by `stonemfg.render-html` to style the generated
        ;; operator console. Pinned as a GIT coordinate (not :local/root)
        ;; because that is how this library expects to be consumed: its own
        ;; deps use :git/sha, and a :local/root would make its transitive
        ;; "../html" lookup break inside a consumer's git cache.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  ;; (kept for parity with sibling actors' deps.edn shape; redundant
  ;; with the top-level :deps override above).
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "stonemfg.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by running the REAL actor
  ;; (advisor -> governor -> phase gate -> store) and rendering its own
  ;; output. Throws rather than writing a page if any HARD governor rule
  ;; in `stonemfg.render-html/expected-hard-rules` failed to fire
  ;; (flagship checklist item 2, ADR-2607189300).
  :render-html {:main-opts ["-m" "stonemfg.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
